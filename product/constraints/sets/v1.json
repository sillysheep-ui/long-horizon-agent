{
  "version": "1.2.0",
  "constraints": [
    {
      "id": "complete",
      "category": "hard",
      "severity": "hard",
      "type": "status_equals",
      "params": {
        "value": "complete"
      }
    },
    {
      "id": "day_count",
      "category": "hard",
      "severity": "hard",
      "type": "count_equals",
      "params": {
        "target": "days"
      }
    },
    {
      "id": "density",
      "category": "hard",
      "severity": "hard",
      "type": "count_between",
      "select": "days[].activities[]",
      "params": {
        "bounds": "day_windows",
        "min": 2,
        "max": 4,
        "require_days": true
      }
    },
    {
      "id": "time_order",
      "category": "hard",
      "severity": "hard",
      "type": "time_order",
      "select": "days[].activities[]",
      "params": {
        "require_days": true
      }
    },
    {
      "id": "no_overlap",
      "category": "hard",
      "severity": "hard",
      "type": "no_overlap",
      "select": "days[].activities[]",
      "params": {
        "include_meals": false,
        "default_minutes": 90,
        "require_times": true,
        "require_order": true
      }
    },
    {
      "id": "day_load",
      "category": "commonsense",
      "severity": "soft",
      "type": "sum_le",
      "select": "days[].activities[]",
      "params": {
        "min_hours": 3.0,
        "tolerance": 0.5,
        "require_days": true,
        "default_hours": 10.0
      }
    },
    {
      "id": "unique_titles",
      "category": "hard",
      "severity": "hard",
      "type": "unique_values",
      "select": "days[].activities[]",
      "params": {
        "field": "title"
      }
    },
    {
      "id": "title_clean",
      "category": "commonsense",
      "severity": "hard",
      "type": "text_clean",
      "select": "days[].activities[]",
      "params": {
        "max_len": 24,
        "tokens": [
          "攻略",
          "门票",
          "地址",
          "图片",
          "开放时间",
          "营业时间",
          "【",
          "】",
          "｜",
          "点评",
          "简介"
        ]
      }
    },
    {
      "id": "city_coverage",
      "category": "hard",
      "severity": "hard",
      "type": "city_coverage",
      "select": "days[]",
      "params": {}
    },
    {
      "id": "evidence_ok",
      "category": "hard",
      "severity": "hard",
      "type": "evidence_ok",
      "select": "days[].activities[]",
      "params": {}
    },
    {
      "id": "periods",
      "category": "hard",
      "severity": "hard",
      "type": "distinct_periods",
      "select": "days[].activities[]",
      "params": {
        "min_periods": 2
      }
    },
    {
      "id": "activity_length",
      "category": "commonsense",
      "severity": "hard",
      "type": "activity_length",
      "select": "days[].activities[]",
      "params": {}
    },
    {
      "id": "free_time",
      "category": "commonsense",
      "severity": "hard",
      "type": "free_time",
      "select": "days[].activities[]",
      "params": {
        "upper_slack": 0.07
      }
    },
    {
      "id": "no_fabricated_cost",
      "category": "hard",
      "severity": "hard",
      "type": "cost_grounded",
      "select": "days[].activities[]",
      "params": {}
    }
  ]
}
